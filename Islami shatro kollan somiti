async function copyNum(n){

  try{

    await navigator
      .clipboard
      .writeText(n);

  }catch{

    const t =
      document.createElement(
        "input"
      );

    t.value = n;

    document.body
      .appendChild(t);

    t.select();

    document.execCommand(
      "copy"
    );

    t.remove();
  }

  toast(
    "Number copied successfully"
  );
}


