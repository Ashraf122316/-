import { getStore } from "@netlify/blobs";
import crypto from "node:crypto";

const store = () => getStore("samiti");

const SECRET = process.env.SESSION_SECRET || "";
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || "";
const ADMIN_MOBILE = process.env.ADMIN_MOBILE || "";

const SESSION_HOURS = 12;

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    }
  });

const fail = (message, status = 400) => json({ error: message }, status);

function now() {
  const d = new Date(Date.now() + 6 * 60 * 60 * 1000);
  return d;
}

function today() {
  return now().toISOString().slice(0, 10);
}

function currentMonth() {
  return today().slice(0, 7);
}

function monthRange(from, to) {
  const result = [];
  let [y, m] = from.split("-").map(Number);
  const [ey, em] = to.split("-").map(Number);

  while (y < ey || (y === ey && m <= em)) {
    result.push(
      `${y}-${String(m).padStart(2, "0")}`
    );

    m++;

    if (m === 13) {
      m = 1;
      y++;
    }
  }

  return result;
}

function clean(v, max = 500) {
  return String(v ?? "")
    .trim()
    .slice(0, max)
    .replace(/[<>]/g, "");
}

function validDate(v) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return false;

  const d = new Date(`${v}T00:00:00Z`);

  return (
    !Number.isNaN(d.getTime()) &&
    d.toISOString().slice(0, 10) === v
  );
}

function validMobile(v) {
  return /^01\d{9}$/.test(v);
}

function validTxn(v) {
  return /^[A-Za-z0-9_-]{4,30}$/.test(v);
}

function hashPassword(password) {
  const salt = crypto.randomBytes(16).toString("hex");

  const hash = crypto.scryptSync(
    password,
    salt,
    64
  ).toString("hex");

  return `${salt}:${hash}`;
}

function verifyPassword(password, stored) {
  const [salt, hash] = String(stored || "").split(":");

  if (!salt || !hash) return false;

  const calculated = crypto.scryptSync(
    password,
    salt,
    64
  ).toString("hex");

  try {
    return crypto.timingSafeEqual(
      Buffer.from(hash, "hex"),
      Buffer.from(calculated, "hex")
    );
  } catch {
    return false;
  }
}

function sign(payload) {
  const body = Buffer.from(
    JSON.stringify(payload)
  ).toString("base64url");

  const sig = crypto
    .createHmac("sha256", SECRET)
    .update(body)
    .digest("base64url");

  return `${body}.${sig}`;
}

function unsign(token) {
  if (!token || !SECRET) return null;

  const [body, sig] = token.split(".");

  if (!body || !sig) return null;

  const expected = crypto
    .createHmac("sha256", SECRET)
    .update(body)
    .digest("base64url");

  if (sig.length !== expected.length) return null;

  try {
    if (
      !crypto.timingSafeEqual(
        Buffer.from(sig),
        Buffer.from(expected)
      )
    ) {
      return null;
    }
  } catch {
    return null;
  }

  try {
    const data = JSON.parse(
      Buffer.from(body, "base64url").toString()
    );

    if (!data.exp || data.exp < Date.now()) {
      return null;
    }

    return data;
  } catch {
    return null;
  }
}

function cookie(name, value, maxAge = 43200) {
  return `${name}=${value}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${maxAge}`;
}

function clearCookie(name) {
  return `${name}=; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=0`;
}

async function loadDB() {
  const data = await store().get("db", {
    type: "json"
  });

  if (data) {
    if (!data.settings) {
      data.settings = defaultSettings();
    }

    if (!data.members) data.members = [];
    if (!data.payments) data.payments = [];
    if (!data.ledger) data.ledger = [];
    if (!data.expenses) data.expenses = [];
    if (!data.notices) data.notices = [];
    if (!data.notifs) data.notifs = [];
    if (!data.audit) data.audit = [];
    if (!data.fails) data.fails = {};
    if (!data.seq) data.seq = { m: 1, r: 1, l: 1 };

    return data;
  }

  const db = {
    members: [],
    payments: [],
    ledger: [],
    expenses: [],
    notices: [],
    notifs: [],
    audit: [],
    fails: {},
    seq: {
      m: 1,
      r: 1,
      l: 1
    },
    settings: defaultSettings()
  };

  if (ADMIN_PASSWORD) {
    db.members.push({
      id: "ADMIN-0001",
      name: "Super Admin",
      mobile: ADMIN_MOBILE,
      role: "super",
      status: "active",
      password: hashPassword(ADMIN_PASSWORD),
      monthly: 0,
      address: "",
      joined: today()
    });
  }

  await saveDB(db);

  return db;
}

async function saveDB(db) {
  return store().setJSON("db", db);
}

function defaultSettings() {
  return {
    name: "ইসলামী ছাত্র কল্যাণ সমিতি",
    nagad: "",
    bkash: "",
    monthly: 100,
    contact: "",
    address: "",
    currency: "৳",
    prefix: "ISK-R",
    instructions: ""
  };
}

function safeUser(user) {
  if (!user) return null;

  const {
    password,
    ...safe
  } = user;

  return safe;
}

function roleRank(role) {
  if (role === "super") return 3;
  if (role === "admin") return 2;
  return 1;
}

function sessionUser(req, db) {
  const cookieHeader =
    req.headers.get("cookie") || "";

  const match = cookieHeader.match(
    /samiti_session=([^;]+)/
  );

  if (!match) return null;

  const session = unsign(match[1]);

  if (!session) return null;

  return db.members.find(
    x =>
      x.id === session.id &&
      x.status === "active"
  ) || null;
}

function requireRole(user, role = "member") {
  if (!user) return false;

  return (
    roleRank(user.role) >=
    roleRank(role)
  );
}

function balance(db, memberId) {
  return db.ledger
    .filter(x => x.mid === memberId)
    .reduce(
      (sum, x) =>
        sum + Number(x.amount || 0),
      0
    );
}

function approvedMonths(db, memberId) {
  return db.payments
    .filter(
      x =>
        x.mid === memberId &&
        x.status === "approved"
    )
    .map(x => x.month);
}

function pendingMonths(db, memberId) {
  return db.payments
    .filter(
      x =>
        x.mid === memberId &&
        x.status === "pending"
    )
    .map(x => x.month);
}

function memberSummary(db, user) {
  const current = currentMonth();

  const start = String(
    user.joined || current
  ).slice(0, 7);

  const months =
    start <= current
      ? monthRange(start, current)
      : [];

  const approved = new Set(
    approvedMonths(db, user.id)
  );

  const pending = new Set(
    pendingMonths(db, user.id)
  );

  const monthList = months.map(m => ({
    m,
    s: approved.has(m)
      ? "paid"
      : pending.has(m)
        ? "pending"
        : "due"
  }));

  const dueMonths = monthList
    .filter(x => x.s === "due")
    .map(x => x.m);

  const totalDeposit = db.ledger
    .filter(x => x.mid === user.id)
    .reduce(
      (a, x) =>
        a + Number(x.amount || 0),
      0
    );

  const payments = db.payments
    .filter(x => x.mid === user.id)
    .sort(
      (a, b) =>
        new Date(b.at) -
        new Date(a.at)
    );

  return {
    balance: balance(db, user.id),
    totalDeposit,
    totalDue:
      dueMonths.length *
      Number(user.monthly || 0),
    dueMonths,
    pendingMonths: [...pending],
    thisMonth:
      approved.has(current)
        ? "paid"
        : pending.has(current)
          ? "pending"
          : "due",
    last: payments[0] || null,
    months: monthList
  };
}

function adminStats(db) {
  const active = db.members.filter(
    x =>
      x.role === "member" &&
      x.status === "active"
  );

  const current = currentMonth();

  let paidMembers = 0;
  let dueMembers = 0;

  for (const m of active) {
    const hasApproved =
      db.payments.some(
        p =>
          p.mid === m.id &&
          p.month === current &&
          p.status === "approved"
      );

    if (hasApproved) {
      paidMembers++;
    } else {
      dueMembers++;
    }
  }

  const approved =
    db.payments.filter(
      x => x.status === "approved"
    );

  const pending =
    db.payments.filter(
      x => x.status === "pending"
    );

  const rejected =
    db.payments.filter(
      x => x.status === "rejected"
    );

  const totalCollection =
    approved.reduce(
      (a, x) =>
        a + Number(x.amount || 0),
      0
    );

  const monthCollection =
    approved
      .filter(
        x => x.month === current
      )
      .reduce(
        (a, x) =>
          a + Number(x.amount || 0),
        0
      );

  const totalExpense =
    db.expenses.reduce(
      (a, x) =>
        a + Number(x.amount || 0),
      0
    );

  const monthly = {};

  for (const p of approved) {
    monthly[p.month] =
      (monthly[p.month] || 0) +
      Number(p.amount || 0);
  }

  const monthlyList =
    Object.entries(monthly)
      .sort(
        (a, b) =>
          a[0].localeCompare(b[0])
      )
      .slice(-6);

  let totalDue = 0;

  for (const m of active) {
    totalDue +=
      memberSummary(db, m).totalDue;
  }

  return {
    totalMembers:
      db.members.filter(
        x => x.role === "member"
      ).length,
    active: active.length,
    inactive:
      db.members.filter(
        x =>
          x.role === "member" &&
          x.status !== "active"
      ).length,
    paidMembers,
    dueMembers,
    pending: pending.length,
    approved: approved.length,
    rejected: rejected.length,
    totalCollection,
    monthCollection,
    totalExpense,
    fund:
      totalCollection -
      totalExpense,
    totalDue,
    monthly: monthlyList
  };
}

function audit(db, by, action, before, after) {
  db.audit.unshift({
    id: db.audit.length + 1,
    at: new Date().toISOString(),
    by,
    action,
    before: before ?? null,
    after: after ?? null
  });

  db.audit =
    db.audit.slice(0, 2000);
}

function notify(db, uid, text) {
  db.notifs.unshift({
    id: Date.now(),
    uid,
    text,
    at: new Date().toISOString()
  });

  db.notifs =
    db.notifs.slice(0, 3000);
}

async function parseBody(req) {
  try {
    return await req.json();
  } catch {
    return {};
  }
}

export default async function handler(req) {
  try {
    if (!SECRET || SECRET.length < 16) {
      return fail(
        "SESSION_SECRET সেট করা হয়নি।",
        500
      );
    }

    const db = await loadDB();

    const url =
      new URL(req.url);

    const path =
      url.pathname
        .replace(/^\/api\/?/, "")
        .replace(/\/$/, "");

    const method = req.method;

    if (
      method !== "GET" &&
      method !== "HEAD"
    ) {
      const requested =
        req.headers.get(
          "x-requested-with"
        );

      if (requested !== "samiti") {
        return fail(
          "Invalid request.",
          403
        );
      }
    }

    const user =
      sessionUser(req, db);

    /* LOGIN */

    if (
      method === "POST" &&
      path === "login"
    ) {
      const b =
        await parseBody(req);

      const id =
        clean(b.id, 50);

      const password =
        String(b.password || "");

      const key =
        id.toLowerCase();

      const failData =
        db.fails[key];

      if (
        failData &&
        failData.until > Date.now()
      ) {
        return fail(
          "অনেকবার ভুল চেষ্টা হয়েছে। কিছুক্ষণ পরে আবার চেষ্টা করুন।",
          429
        );
      }

      const found =
        db.members.find(
          x =>
            x.id.toLowerCase() ===
              id.toLowerCase() ||
            x.mobile === id
        );

      if (
        !found ||
        found.status !== "active" ||
        !verifyPassword(
          password,
          found.password
        )
      ) {
        const f =
          db.fails[key] || {
            count: 0,
            until: 0
          };

        f.count++;

        if (f.count >= 5) {
          f.until =
            Date.now() +
            15 * 60 * 1000;
          f.count = 0;
        }

        db.fails[key] = f;

        await saveDB(db);

        return fail(
          "আইডি/মোবাইল অথবা পাসওয়ার্ড ভুল।",
          401
        );
      }

      delete db.fails[key];

      const token =
        sign({
          id: found.id,
          exp:
            Date.now() +
            SESSION_HOURS *
              60 *
              60 *
              1000
        });

      await saveDB(db);

      return new Response(
        JSON.stringify({
          ok: true
        }),
        {
          headers: {
            "content-type":
              "application/json",
            "cache-control":
              "no-store",
            "set-cookie":
              cookie(
                "samiti_session",
                token
              )
          }
        }
      );
    }

    /* LOGOUT */

    if (
      method === "POST" &&
      path === "logout"
    ) {
      return new Response(
        JSON.stringify({
          ok: true
        }),
        {
          headers: {
            "content-type":
              "application/json",
            "set-cookie":
              clearCookie(
                "samiti_session"
              )
          }
        }
      );
    }

    /* ME */

    if (
      method === "GET" &&
      path === "me"
    ) {
      if (!user) {
        return fail(
          "Login required.",
          401
        );
      }

      const response = {
        user: safeUser(user),
        settings: db.settings,
        notices: db.notices.slice(
          0,
          30
        ),
        notifs: db.notifs
          .filter(
            x =>
              x.uid === user.id ||
              x.uid === "*"
          )
          .slice(0, 50)
      };

      if (user.role === "member") {
        response.summary =
          memberSummary(
            db,
            user
          );
      }

      if (roleRank(user.role) >= 2) {
        response.stats =
          adminStats(db);
      }

      if (user.role === "super") {
        response.fullSettings =
          db.settings;
      }

      return json(response);
    }

    if (!user) {
      return fail(
        "Login required.",
        401
      );
    }

    /* MEMBER PAYMENT */

    if (
      method === "POST" &&
      path === "pay"
    ) {
      if (
        user.role !== "member"
      ) {
        return fail(
          "শুধু সদস্য payment submit করতে পারবেন।",
          403
        );
      }

      const b =
        await parseBody(req);

      const month =
        clean(b.month, 7);

      const amount =
        Number(b.amount);

      const methodName =
        clean(b.method, 20)
          .toLowerCase();

      const txn =
        clean(
          b.txn,
          40
        ).toUpperCase();

      const date =
        clean(
          b.date,
          10
        );

      const note =
        clean(
          b.note,
          300
        );

      const current =
        currentMonth();

      const joined =
        String(
          user.joined || current
        ).slice(0, 7);

      if (
        !/^\d{4}-\d{2}$/.test(
          month
        )
      ) {
        return fail(
          "সঠিক মাস নির্বাচন করুন।"
        );
      }

      if (
        month > current ||
        month < joined
      ) {
        return fail(
          "এই মাসের payment দেওয়া যাবে না।"
        );
      }

      if (
        !Number.isFinite(amount) ||
        amount !==
          Number(user.monthly)
      ) {
        return fail(
          "চাঁদার পরিমাণ সঠিক নয়।"
        );
      }

      if (
        !["nagad", "bkash"].includes(
          methodName
        )
      ) {
        return fail(
          "Payment method সঠিক নয়।"
        );
      }

      if (!validTxn(txn)) {
        return fail(
          "Transaction ID সঠিক নয়।"
        );
      }

      if (!validDate(date)) {
        return fail(
          "Payment date সঠিক নয়।"
        );
      }

      if (date > today()) {
        return fail(
          "ভবিষ্যতের তারিখ দেওয়া যাবে না।"
        );
      }

      if (
        db.payments.some(
          p =>
            p.txn === txn &&
            p.status !== "rejected"
        )
      ) {
        return fail(
          "এই Transaction ID আগে ব্যবহার করা হয়েছে।"
        );
      }

      if (
        db.payments.some(
          p =>
            p.mid === user.id &&
            p.month === month &&
            ["pending", "approved"].includes(
              p.status
            )
        )
      ) {
        return fail(
          "এই মাসের payment ইতিমধ্যে জমা দেওয়া হয়েছে।"
        );
      }

      const payment = {
        id:
          `PAY-${Date.now()}-${crypto
            .randomBytes(3)
            .toString("hex")}`,
        mid: user.id,
        mname: user.name,
        amount,
        method: methodName,
        txn,
        date,
        month,
        note,
        status: "pending",
        at: new Date().toISOString()
      };

      db.payments.unshift(
        payment
      );

      notify(
        db,
        "*",
        `${user.name} (${user.id}) ${month} মাসের ${amount} টাকার payment submit করেছে।`
      );

      audit(
        db,
        user.id,
        "PAYMENT_SUBMITTED",
        null,
        payment
      );

      await saveDB(db);

      return json({
        ok: true,
        payment
      });
    }

    /* PAYMENTS */

    if (
      method === "GET" &&
      path === "payments"
    ) {
      if (
        !requireRole(user, "admin")
      ) {
        return json({
          payments:
            db.payments
              .filter(
                x =>
                  x.mid ===
                  user.id
              )
              .slice(0, 500)
        });
      }

      const status =
        url.searchParams.get(
          "status"
        );

      let payments =
        db.payments;

      if (status) {
        payments =
          payments.filter(
            x =>
              x.status ===
              status
          );
      }

      return json({
        payments:
          payments.slice(0, 1000)
      });
    }

    /* REVIEW */

    if (
      method === "POST" &&
      path === "review"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const id =
        clean(b.id, 100);

      const action =
        clean(b.action, 20);

      const reason =
        clean(
          b.reason,
          300
        );

      const payment =
        db.payments.find(
          x => x.id === id
        );

      if (!payment) {
        return fail(
          "Payment পাওয়া যায়নি।",
          404
        );
      }

      if (
        payment.status !==
        "pending"
      ) {
        return fail(
          "এই payment ইতিমধ্যে review হয়েছে।"
        );
      }

      const before = {
        ...payment
      };

      if (action === "approve") {
        payment.status =
          "approved";

        const ledger = {
          id:
            `LED-${db.seq.l++}`,
          mid:
            payment.mid,
          amount:
            payment.amount,
          type:
            "contribution",
          ref:
            payment.id,
          month:
            payment.month,
          at:
            new Date().toISOString()
        };

        db.ledger.push(
          ledger
        );

        payment.balAfter =
          balance(
            db,
            payment.mid
          );

        payment.receipt =
          `${db.settings.prefix}-${String(
            db.seq.r++
          ).padStart(6, "0")}`;

        notify(
          db,
          payment.mid,
          `${payment.month} মাসের payment অনুমোদিত হয়েছে। Receipt: ${payment.receipt}`
        );
      } else if (
        action === "reject"
      ) {
        payment.status =
          "rejected";

        payment.reason =
          reason ||
          "Payment যাচাই করা যায়নি।";

        notify(
          db,
          payment.mid,
          `${payment.month} মাসের payment বাতিল হয়েছে। কারণ: ${payment.reason}`
        );
      } else {
        return fail(
          "Review action সঠিক নয়।"
        );
      }

      audit(
        db,
        user.id,
        `PAYMENT_${action.toUpperCase()}`,
        before,
        payment
      );

      await saveDB(db);

      return json({
        ok: true,
        payment
      });
    }

    /* RECEIPT */

    if (
      method === "GET" &&
      path === "receipt"
    ) {
      const id =
        url.searchParams.get(
          "id"
        );

      const payment =
        db.payments.find(
          x =>
            x.id === id &&
            x.status ===
              "approved"
        );

      if (!payment) {
        return fail(
          "Receipt পাওয়া যায়নি।",
          404
        );
      }

      if (
        user.role === "member" &&
        payment.mid !==
          user.id
      ) {
        return fail(
          "Access denied.",
          403
        );
      }

      return json({
        org:
          db.settings.name,
        receipt: payment
      });
    }

    /* MEMBERS */

    if (
      method === "GET" &&
      path === "members"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const members =
        db.members
          .filter(
            x =>
              x.role ===
              "member"
          )
          .map(m => ({
            ...safeUser(m),
            balance:
              balance(
                db,
                m.id
              ),
            thisMonth:
              memberSummary(
                db,
                m
              ).thisMonth
          }));

      return json({
        members
      });
    }

    /* ADD MEMBER */

    if (
      method === "POST" &&
      path === "member"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const name =
        clean(
          b.name,
          100
        );

      const mobile =
        clean(
          b.mobile,
          11
        );

      const monthly =
        Number(b.monthly);

      const password =
        String(
          b.password || ""
        );

      const address =
        clean(
          b.address,
          300
        );

      const role =
        clean(
          b.role || "member",
          20
        );

      if (!name) {
        return fail(
          "নাম দিন।"
        );
      }

      if (
        !validMobile(mobile)
      ) {
        return fail(
          "সঠিক Bangladesh mobile number দিন।"
        );
      }

      if (
        db.members.some(
          x =>
            x.mobile ===
            mobile
        )
      ) {
        return fail(
          "এই mobile number আগে ব্যবহার হয়েছে।"
        );
      }

      if (
        !Number.isFinite(
          monthly
        ) ||
        monthly <= 0
      ) {
        return fail(
          "মাসিক চাঁদা সঠিক নয়।"
        );
      }

      if (
        password.length <
        8
      ) {
        return fail(
          "Password কমপক্ষে ৮ অক্ষরের হতে হবে।"
        );
      }

      if (
        !["member", "admin", "super"].includes(
          role
        )
      ) {
        return fail(
          "Role সঠিক নয়।"
        );
      }

      if (
        role !== "member" &&
        user.role !== "super"
      ) {
        return fail(
          "শুধু Super Admin admin তৈরি করতে পারবেন।",
          403
        );
      }

      const id =
        `ISK-${String(
          ++db.seq.m
        ).padStart(4, "0")}`;

      const member = {
        id,
        name,
        mobile,
        role,
        status: "active",
        password:
          hashPassword(
            password
          ),
        monthly,
        address,
        joined: today()
      };

      db.members.push(
        member
      );

      audit(
        db,
        user.id,
        "MEMBER_CREATED",
        null,
        safeUser(member)
      );

      await saveDB(db);

      return json({
        ok: true,
        id
      });
    }

    /* UPDATE MEMBER */

    if (
      method === "POST" &&
      path === "member/update"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const id =
        clean(b.id, 50);

      const member =
        db.members.find(
          x => x.id === id
        );

      if (!member) {
        return fail(
          "Member পাওয়া যায়নি।",
          404
        );
      }

      if (
        member.role !==
        "member" &&
        user.role !==
          "super"
      ) {
        return fail(
          "এই account পরিবর্তন করার অনুমতি নেই।",
          403
        );
      }

      const before = {
        ...safeUser(member)
      };

      if (
        b.status !==
        undefined
      ) {
        if (
          !["active", "inactive"].includes(
            b.status
          )
        ) {
          return fail(
            "Status সঠিক নয়।"
          );
        }

        member.status =
          b.status;
      }

      if (
        b.monthly !==
        undefined
      ) {
        const monthly =
          Number(
            b.monthly
          );

        if (
          !Number.isFinite(
            monthly
          ) ||
          monthly <= 0
        ) {
          return fail(
            "Monthly amount সঠিক নয়।"
          );
        }

        member.monthly =
          monthly;
      }

      if (
        b.password
      ) {
        if (
          String(
            b.password
          ).length < 8
        ) {
          return fail(
            "Password কমপক্ষে ৮ অক্ষর।"
          );
        }

        member.password =
          hashPassword(
            String(
              b.password
            )
          );
      }

      audit(
        db,
        user.id,
        "MEMBER_UPDATED",
        before,
        safeUser(member)
      );

      await saveDB(db);

      return json({
        ok: true
      });
    }

    /* NOTICE */

    if (
      method === "POST" &&
      path === "notice"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const title =
        clean(
          b.title,
          150
        );

      const text =
        clean(
          b.text,
          1000
        );

      const priority =
        clean(
          b.priority ||
            "normal",
          20
        );

      if (!title || !text) {
        return fail(
          "Title এবং notice text দিন।"
        );
      }

      const notice = {
        id:
          Date.now(),
        title,
        text,
        priority,
        by: user.name,
        at:
          new Date().toISOString()
      };

      db.notices.unshift(
        notice
      );

      notify(
        db,
        "*",
        `নতুন নোটিশ: ${title}`
      );

      audit(
        db,
        user.id,
        "NOTICE_CREATED",
        null,
        notice
      );

      await saveDB(db);

      return json({
        ok: true
      });
    }

    /* EXPENSE */

    if (
      method === "GET" &&
      path === "expenses"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      return json({
        expenses:
          db.expenses
            .slice(0, 1000)
      });
    }

    if (
      method === "POST" &&
      path === "expense"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const date =
        clean(
          b.date,
          10
        );

      const category =
        clean(
          b.category,
          100
        );

      const amount =
        Number(
          b.amount
        );

      const description =
        clean(
          b.description,
          500
        );

      if (!validDate(date)) {
        return fail(
          "সঠিক date দিন।"
        );
      }

      if (
        !category ||
        !description
      ) {
        return fail(
          "Category এবং description দিন।"
        );
      }

      if (
        !Number.isFinite(
          amount
        ) ||
        amount <= 0
      ) {
        return fail(
          "সঠিক amount দিন।"
        );
      }

      const expense = {
        id:
          `EXP-${Date.now()}`,
        date,
        category,
        amount,
        description,
        by: user.id,
        at:
          new Date().toISOString()
      };

      db.expenses.unshift(
        expense
      );

      audit(
        db,
        user.id,
        "EXPENSE_CREATED",
        null,
        expense
      );

      await saveDB(db);

      return json({
        ok: true
      });
    }

    /* SETTINGS */

    if (
      method === "POST" &&
      path === "settings"
    ) {
      if (
        user.role !==
        "super"
      ) {
        return fail(
          "Super Admin access required.",
          403
        );
      }

      const b =
        await parseBody(req);

      const before =
        { ...db.settings };

      const settings = {
        ...db.settings
      };

      if (
        b.name !==
        undefined
      ) {
        settings.name =
          clean(
            b.name,
            150
          );
      }

      if (
        b.nagad !==
        undefined
      ) {
        settings.nagad =
          clean(
            b.nagad,
            20
          );
      }

      if (
        b.bkash !==
        undefined
      ) {
        settings.bkash =
          clean(
            b.bkash,
            20
          );
      }

      if (
        b.monthly !==
        undefined
      ) {
        const monthly =
          Number(
            b.monthly
          );

        if (
          !Number.isFinite(
            monthly
          ) ||
          monthly <= 0
        ) {
          return fail(
            "Monthly amount সঠিক নয়।"
          );
        }

        settings.monthly =
          monthly;
      }

      if (
        b.contact !==
        undefined
      ) {
        settings.contact =
          clean(
            b.contact,
            100
          );
      }

      if (
        b.address !==
        undefined
      ) {
        settings.address =
          clean(
            b.address,
            300
          );
      }

      if (
        b.currency !==
        undefined
      ) {
        settings.currency =
          clean(
            b.currency,
            10
          );
      }

      if (
        b.prefix !==
        undefined
      ) {
        settings.prefix =
          clean(
            b.prefix,
            20
          );
      }

      if (
        b.instructions !==
        undefined
      ) {
        settings.instructions =
          clean(
            b.instructions,
            1000
          );
      }

      db.settings =
        settings;

      audit(
        db,
        user.id,
        "SETTINGS_UPDATED",
        before,
        settings
      );

      await saveDB(db);

      return json({
        ok: true
      });
    }

    /* AUDIT */

    if (
      method === "GET" &&
      path === "audit"
    ) {
      if (
        !requireRole(
          user,
          "admin"
        )
      ) {
        return fail(
          "Admin access required.",
          403
        );
      }

      return json({
        audit:
          db.audit.slice(
            0,
            1000
          )
      });
    }

    return fail(
      "Endpoint not found.",
      404
    );
  } catch (error) {
    console.error(error);

    return fail(
      "Server error হয়েছে।",
      500
    );
  }
}


