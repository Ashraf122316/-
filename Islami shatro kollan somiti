const esc =
  s =>
    String(s ?? "")
      .replace(
        /[&<>\"']/g,
        c => ({
          "&":"&amp;",
          "<":"&lt;",
          ">":"&gt;",
          "\"":"&quot;",
          "'":"&#39;"
        }[c])
      );

const money =
  n =>
    "৳" +
    Number(n || 0)
      .toLocaleString("bn-BD");

const MN = [
  "জানুয়ারি",
  "ফেব্রুয়ারি",
  "মার্চ",
  "এপ্রিল",
  "মে",
  "জুন",
  "জুলাই",
  "আগস্ট",
  "সেপ্টেম্বর",
  "অক্টোবর",
  "নভেম্বর",
  "ডিসেম্বর"
];

const mlabel =
  m => {

    const [y,x] =
      m.split("-");

    return (
      MN[
        Number(x) - 1
      ] +
      " " +
      Number(y)
        .toLocaleString(
          "bn-BD",
          {
            useGrouping:false
          }
        )
    );
  };

const dt =
  s =>
    new Date(s)
      .toLocaleDateString(
        "bn-BD"
      );

const ST = {
  paid:"পরিশোধিত",
  due:"বকেয়া",
