async function review(
  id,
  action,
  btn
){

  let reason;

  if (
    action ===
    "reject"
  ){

    reason =
      prompt(
        "বাতিলের কারণ লিখুন"
      );

    if (!reason)
      return;

  }else{

    if (
      !confirm(
        "এই পেমেন্ট অনুমোদন করবেন?"
      )
    )
      return;
  }

  busy(
    btn,
    async () => {

      await api(
        "review",
        {
          id,
          action,
          reason
        }
      );

      toast(
        action ===
        "approve"
          ? "অনুমোদিত হয়েছে"
          : "বাতিল হয়েছে"
      );

      await reload();

      go("pend");
    }
  );
}


