  nagad:"Nagad",
  bkash:"bKash"
};


async function api(
  p,
  b
){

  const r =
    await fetch(
      "/api/" + p,
      {
        method:
          b
            ? "POST"
            : "GET",

        headers:{
          "content-type":
            "application/json",

          "x-requested-with":
            "samiti"
        },

        body:
          b
            ? JSON.stringify(b)
            : undefined
      }
    );

  const d =
    await r
      .json()
      .catch(
        () => ({})
      );

  if (!r.ok){

    const e =
      new Error(
        d.error ||
        "ত্রুটি হয়েছে"
      );

    e.status =
      r.status;

    throw e;
  }

  return d;
}


let tt;

function toast(
  m,
  er
){

  const t =
    $("#toast");

  t.textContent = m;

  t.className =
    er
      ? "er"
      : "";

  clearTimeout(tt);

  tt =
    setTimeout(
      () =>
        t.className =
          "hide",
      3500
    );
}


const fail =
  e =>
    toast(
      e.message,
      true
    );


async function busy(
  btn,
  fn
){

  if (btn)
    btn.disabled = true;

  try{
    await fn();
  }catch(e){
    fail(e);
  }finally{
    if (btn)
      btn.disabled = false;
  }
}


async function boot(){

  try{

    D =
      await api("me");

    $("#login")
      .classList
      .add("hide");

    $("#app")
      .classList
      .remove("hide");

    V =
      isAdmin()
        ? "dash"
        : "home";

    render();

  }catch(e){

    $("#app")
      .classList
      .add("hide");

    $("#login")
      .classList
      .remove("hide");
  }
}


const isAdmin =
  () =>
    D &&
    D.user.role !==
      "member";


async function doLogin(){

  busy(
    $("#lbtn"),
    async () => {

      await api(
        "login",
        {
          id:
            $("#lid").value,

          password:
            $("#lpw").value
        }
      );

      $("#lpw").value =
        "";

      await boot();
    }
  );
}


$("#lpw")
  .addEventListener(
    "keydown",
    e =>
      e.key === "Enter" &&
      doLogin()
  );


async function logout(){

  await api(
    "logout",
    {}
  );

  D = null;

  boot();
}


async function reload(){

  D =
    await api("me");

  render();
}


